# Copy this file to .env and change every secret before deployment.
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
EVENT_NAME=IGEO Alumni Annual Dinner 2026
REGISTRATION_FEE=5000
CURRENCY=PKR
ACCOUNT_TITLE=YOUR ACCOUNT TITLE
BANK_NAME=YOUR BANK / WALLET NAME
ACCOUNT_NUMBER=YOUR ACCOUNT NUMBER
PAYMENT_INSTRUCTIONS=Transfer PKR 5,000 and upload the transaction receipt.
# Optional: path to a payment QR image placed in static/images/payment_qr.png
PAYMENT_QR_IMAGE=payment_qr.png
# Optional production database. Render PostgreSQL URL can be placed here.
DATABASE_URL=
# Local upload folder. On Render, use a persistent disk and set this to its mount path.
UPLOAD_FOLDER=uploads
